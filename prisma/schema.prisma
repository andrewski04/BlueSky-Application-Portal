datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/**
 * The ApplicationForm acts as a templates for Applications, defining the question response types and prompt.
 */
model ApplicationForm {
  id          String        @id @default(cuid())
  name        String
  description String?
  published   Boolean       @default(false)
  active      Boolean       @default(true)
  sections    FormSection[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ApplicationResponse ApplicationResponse[]
}

model FormSection {
  id           String          @id @default(cuid())
  formId       String
  form         ApplicationForm @relation(fields: [formId], references: [id])
  name         String
  slug         String
  description  String?
  displayOrder Int
  questions    FormQuestion[]
}

enum QuestionType {
  TEXT
  PARAGRAPH
  MULTIPLE_CHOICE
  DROPDOWN
  CHECKBOX
  FILE_UPLOAD
  DATE
  NUMBER
}

model FormQuestion {
  id        String       @id @default(cuid())
  sectionId String
  section   FormSection  @relation(fields: [sectionId], references: [id])
  type      QuestionType
  prompt    String
  required  Boolean
  order     Int
  slug      String

  maxLength        Int? /// TEXT / PARAGRAPH
  minValue         Float? /// NUMBER
  maxValue         Float? /// NUMBER
  minDate          DateTime? /// DATE
  maxDate          DateTime? /// DATE
  acceptedTypes    String? /// FILE_UPLOAD 
  maxFileSizeBytes Int? /// FILE_UPLOAD 

  options FormQuestionOption[] /// MULTI-CHOICE / DROPDOWN / CHECKBOX
  Answer  Answer[]
}

model FormQuestionOption {
  id                    String                  @id @default(cuid())
  questionId            String
  question              FormQuestion            @relation(fields: [questionId], references: [id])
  text                  String
  order                 Int
  slug                  String
  AnswerOptionSelection AnswerOptionSelection[]
}

/**
 * The Application model represents an application form filled out by a user.
 */
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ApplicationResponse {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  formId      String
  form        ApplicationForm   @relation(fields: [formId], references: [id])
  status      ApplicationStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  answers Answer[]

  @@unique([userId, formId])
  @@index([formId])
}

model Answer {
  id            String       @id @default(cuid())
  applicationId String
  application   ApplicationResponse  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      FormQuestion @relation(fields: [questionId], references: [id])

  valueText    String?
  valueNumber  Float?
  valueBool    Boolean?
  valueDate    DateTime?
  fileUploadId String?

  selectedOptions AnswerOptionSelection[]
  FileUpload      FileUpload?             @relation(fields: [fileUploadId], references: [id])

  @@index([applicationId, questionId])
  @@index([questionId])
}

model AnswerOptionSelection {
  answerId String
  answer   Answer             @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId String
  option   FormQuestionOption @relation(fields: [optionId], references: [id])

  @@id([answerId, optionId])
}

model FileUpload {
  id          String   @id @default(cuid())
  // file metadata
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String /// S3 location
  uploadedAt  DateTime @default(now())

  // reverse relation
  answers Answer[]
}

/**
 * The User model represents a user (both applicants and admins) of the application.
 */

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String        @id @default(cuid(2))
  email       String        @unique
  firstName   String?
  lastName    String?
  role        UserRole      @default(USER)
  sessions    Session[]
  isSetup     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  ApplicationResponse ApplicationResponse[]
}

/**
 * The Session represents an active, logged in user Session and is used to verify the user's session cookie.
 */
model Session {
  hashedToken String   @id
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * The MagicToken model handles the MagicToken link sent to a users Email, and the associated OTP if one is generated.
 * Once verified, these are deleted and the User is given a Session.
 */
model MagicToken {
  hashedToken String   @id
  hashedOtp   String?
  deviceId    String
  email       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
