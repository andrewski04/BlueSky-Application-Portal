/**
 * The User model represents a user (both applicants and admins) of the application.
 */

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String                @id @default(cuid(2))
  email               String                @unique
  firstName           String?
  lastName            String?
  etsuApplicationComplete Boolean               @default(false)
  etsuENumber           String?
  etsuEmail             String?
  phoneNumber           String?
  role                UserRole              @default(USER)
  sessions            Session[]
  isSetup             Boolean               @default(false)
  createdAt           DateTime              @default(now())
  ApplicationResponse ApplicationResponse[]
  Announcement        Announcement[]
}

/**
 * The Session represents an active, logged in user Session and is used to verify the user's session cookie.
 */
model Session {
  hashedToken String   @id
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * The MagicToken model handles the MagicToken link sent to a users Email, and the associated OTP if one is generated.
 * Once verified, these are deleted and the User is given a Session.
 */
model MagicToken {
  hashedToken String   @id
  hashedOtp   String?
  deviceId    String
  email       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
