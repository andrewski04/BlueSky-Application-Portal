{
	"name": "bluesky-application-portal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"prisma": {
		"schema": "./prisma"
	},
	"scripts": {
		"dev": "TZ=UTC vite dev",
		"build": "TZ=UTC vite build",
		"preview": "TZ=UTC vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"postinstall": "cd docs && npm install",
		"docs": "npm --prefix docs start",
		"docs:build": "npm --prefix docs run build",
		"init-minio": "node scripts/init-minio.js",
		"cleanup-files": "node scripts/cleanup-orphaned-files.js",
		"generate-test-data": "node scripts/generate-test-data.js",
		"cleanup-test-data": "node scripts/cleanup-test-data.js"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.13.9",
		"@types/nodemailer": "^6.4.17",
		"@types/nprogress": "^0.2.3",
		"@types/sortablejs": "^1.15.8",
		"@vitest/coverage-istanbul": "^3.0.8",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "^6.12.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.5",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.8"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.859.0",
		"@aws-sdk/s3-request-presigner": "^3.859.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@prisma/client": "^6.12.0",
		"canvas-confetti": "^1.9.3",
		"dotenv": "^17.0.0",
		"nanoid": "^5.1.3",
		"nodemailer": "^6.10.0",
		"nprogress": "^0.2.0",
		"puppeteer": "^24.16.1",
		"sortablejs": "^1.15.6",
		"svelte-dnd-action": "^0.9.64",
		"svelte-tel-input": "^3.6.0"
	}
}
